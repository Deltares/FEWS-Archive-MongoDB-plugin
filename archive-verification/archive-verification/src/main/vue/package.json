{
  "name": "ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --config vite.mock.config.js",
    "build": "vite build --emptyOutDir",
    "build:debug": "vite build --mode development --emptyOutDir",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check src/ mock/ *.js",
    "format:fix": "prettier --write src/ mock/ *.js",
    "test": "vitest run",
    "verify": "npm run lint && npm run format && npm test"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "json-editor-vue": "^0.19.2",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "vuetify": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.8",
    "prettier": "^3.9.6",
    "vite": "^8.2.2",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.11"
  }
}
